# Copy to backend/.env for local development. The real environment always wins over this file.
# Every key is optional in development; production refuses to boot until the required ones are set.

# development | test | production
DJANGO_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Required in production: 32+ random characters, and the public hostname(s).
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Proxy hops in front of the app that set X-Forwarded-For (0 when nothing sits in front).
NUM_PROXIES=0

# Outside services. Each one runs in a mode:
#   off       - the feature is disabled and its calls fail with SERVICE_DISABLED
#   simulated - deterministic in-process fakes, no network (default in test)
#   live      - the real public API (default in development and production)
# This file picks simulated so a fresh checkout works offline; delete these three lines
# (or set them to live) to plan against real roads and forecasts.
ROUTING_MODE=simulated
GEOCODING_MODE=simulated
WEATHER_MODE=simulated

# Live endpoints. All three are free and need no key.
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com
# Only for Open-Meteo's commercial plan: set the key AND point OPEN_METEO_URL at
# https://customer-api.open-meteo.com. Half of the pair is a boot error.
OPEN_METEO_API_KEY=

HTTP_TIMEOUT_S=15
WEATHER_CACHE_TTL_S=900

# Where the built React app lives (served by Django in production).
# Defaults to ../frontend/dist.
FRONTEND_DIST_DIR=
