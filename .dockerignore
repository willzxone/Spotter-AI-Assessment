# Keep the build context to source: dependencies are installed inside the image.
.git
**/.DS_Store

# Python
**/.venv
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/.import_linter_cache
backend/staticfiles
backend/tests
*.sqlite3

# Node
**/node_modules
frontend/dist
frontend/.tanstack
frontend/test
*.tsbuildinfo

# Env and secrets never enter the image; the host supplies them at run time.
**/.env
**/.env.*
!**/.env.example
